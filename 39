#include <stdio.h>
#include <math.h>

// Recursive function simulating T(n) = 2T(n/2) + n log n
double distributed_sorting(double n) {
    if (n <= 1) {
        return 1; // Base case
    }
    // 2 * T(n/2) + n * log2(n)
    return 2 * distributed_sorting(n / 2) + (n * log2(n));
}

int main() {
    double data_size = 64; // Example data chunks
    printf("--- Distributed Systems File Sorting ---\n");
    printf("Input size (data fragments): %.0f\n", data_size);
    
    double total_operations = distributed_sorting(data_size);
    
    printf("Total simulated operations: %.2f\n", total_operations);
    printf("Asymptotic Complexity: Theta(n log^2 n)\n");
    return 0;
}
